#!/usr/sbin/nft -f
# Set-only fragment — used by install.sh when the main config has no inline set.
# The drop rule must live in chain input of /etc/nftables.conf (early), NOT here:
# a separate "chain input { drop }" block appended via include runs AFTER your
# accept rules and will not block banned IPs.

table inet filter {
	set blocked_ips {
		type ipv4_addr
		flags timeout
		timeout 1h
	}
}
