[Unit]
Description=Bouncer - server bouncer for web scanners and SSH brute-force
After=network-online.target nftables.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
SupplementaryGroups=caddy
ExecStart=/usr/local/bin/bouncer --config /etc/bouncer/config.toml run
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
KillMode=mixed
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW

[Install]
WantedBy=multi-user.target
